generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String @id @default(cuid())
  username          String @unique
  email             String @unique
  password          String
  created           DateTime @default(now())
  activated         Boolean @default(true)
  activation_code   String?
}